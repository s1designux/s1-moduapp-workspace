 "terms": [
  {
   "term": "딤",
   "means": "영상을 한 번 누르면 위·아래가 검게 깔리며 조작 버튼이 뜨는 상태",
   "also_called": [
    "영상 뷰 딤",
    "조작 버튼 덮개",
    "컨트롤 표시"
   ]
  },
  {
   "term": "세로 기본 / 가로 확대",
   "means": "화면 방향. 가로 확대는 전체화면 버튼 또는 기기 회전으로 들어감",
   "also_called": [
    "기본",
    "확대",
    "전체화면"
   ]
  },
  {
   "term": "단일채널 / 다채널",
   "means": "카메라 1대를 크게 / 여러 대를 격자로",
   "also_called": [
    "1채널",
    "N채널",
    "분할"
   ]
  },
  {
   "term": "분할 표기",
   "means": "세로 1×2·1×3·2×4(2·3·8채널), 가로 2×2·3×3·4×4(4·9·16채널)",
   "also_called": [
    "화면 구성"
   ]
  },
  {
   "term": "바텀시트",
   "means": "세로에서 아래에서 올라오는 창(제목 + 닫기 X)",
   "also_called": [
    "시트"
   ]
  },
  {
   "term": "가운데 팝업",
   "means": "가로에서 가운데 뜨는 창(폭 최대 480, 높이 화면의 80%)",
   "also_called": [
    "가운데 시트",
    "팝업"
   ]
  },
  {
   "term": "오른쪽 패널",
   "means": "가로에서 오른쪽에 붙는 창, 영상은 왼쪽으로 작아짐",
   "also_called": [
    "측면 패널"
   ]
  },
  {
   "term": "토스트",
   "means": "영상 아래 가운데 잠깐 뜨는 알림 알약",
   "also_called": [
    "안내 토스트",
    "배율 표시"
   ]
  },
  {
   "term": "맥락",
   "means": "사용자가 하려는 일 15가지(맥락 파일의 contexts)",
   "also_called": [
    "기능 묶음"
   ]
  },
  {
   "term": "부품 묶음",
   "means": "거의 늘 함께 나오는 부품 조합 12개(유형 파일의 bundles)",
   "also_called": []
  },
  {
   "term": "대표 상태",
   "means": "화면 하나에 붙인 상태 8가지 중 하나(덮는 쪽 우선)",
   "also_called": [
    "state_type"
   ]
  },
  {
   "term": "원본 번호 / 사본 번호",
   "means": "원본 Figma 화면 번호 11:NNNNN, 사본 파일 번호 2805:(NNNNN+2461)",
   "also_called": []
  }
 ],
